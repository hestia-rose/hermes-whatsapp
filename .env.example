# Tambahkan baris-baris ini ke ~/.hermes/.env untuk mengaktifkan WhatsApp.
# Ganti nomor di bawah dengan nomor kamu sendiri (format internasional, tanpa +).

# Aktifkan platform WhatsApp di gateway Hermes
WHATSAPP_ENABLED=true

# Mode bot: nomor bot adalah nomor khusus (mis. WhatsApp Business) yang di-chat pengguna.
# Kebalikan dari "self-chat" (mengobrol dengan diri sendiri di nomor yang sama).
WHATSAPP_MODE=bot

# HANYA nomor ini yang dilayani Hermes. Isi nomor UTAMA kamu — bukan nomor bot.
# Pisahkan dengan koma bila lebih dari satu.
WHATSAPP_ALLOWED_USERS=628xxxxxxxxxx

# DM hanya dari daftar izin di atas.
WHATSAPP_DM_POLICY=allowlist
